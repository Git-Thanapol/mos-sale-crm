# Copy to .env and fill in for local dev. Never commit the real .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# prod only: set to 1 once TLS is terminated in front of the app, 0 until then.
DJANGO_SECURE_SSL_REDIRECT=1

POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Only used by scripts/bench_pages.py to compare against the legacy app pre-cutover.
LEGACY_STREAMLIT_URL=https://sales-dashboard-ngzg5jx9lwqosnpnplbuk2.streamlit.app
